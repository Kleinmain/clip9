{
  "name": "shared-clipboard",
  "version": "1.0.0",
  "private": true,
  "description": "A shared online clipboard keyed by a number in the URL. Runs on Netlify Functions + Netlify Blobs.",
  "scripts": {
    "build": "esbuild src/editor-entry.js --bundle --format=iife --target=es2020 --outfile=public/editor.bundle.js"
  },
  "dependencies": {
    "@netlify/blobs": "^8.1.0",
    "codemirror": "^5.65.20",
    "dompurify": "^3.3.0",
    "marked": "^17.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
